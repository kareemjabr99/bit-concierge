# Key NAMES only. Never commit a value.
# Copy to .env.local and fill it in there; .env.local is gitignored.

NODE_ENV=
LOG_LEVEL=
PORT=

# --- Database -------------------------------------------------------------
# Application connection. Role: bitc_app. Row-level security IS enforced.
DATABASE_URL=
# Migration connection. Role: bitc_migrator. Schema owner. CI and deploy only.
DATABASE_URL_MIGRATOR=

# --- Encryption -----------------------------------------------------------
# 32 bytes, base64. Encrypts Shopify access tokens at rest (AES-256-GCM).
# Rotate by incrementing the version and keeping the previous key readable.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=
ENCRYPTION_KEY_PREVIOUS=
# Salts blind indexes (order numbers, IPs in order_lookup_attempts). 16+ chars.
# Optional in development; required in production.
BLIND_INDEX_SALT=

# --- Models ---------------------------------------------------------------
# Google AI Studio. NOTE: free-tier prompts are used for training — synthetic
# and development-store data only until a paid key under a DPA is in place.
GOOGLE_GENERATIVE_AI_API_KEY=
# Present but unused in v1. Proves the provider abstraction in a test.
ANTHROPIC_API_KEY=

# --- Shopify (Phase 4) ----------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=

# --- Escalation email (Phase 4) -------------------------------------------
RESEND_API_KEY=
ESCALATION_FROM_EMAIL=

# --- Meta channels (Phase 6) ----------------------------------------------
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Widget ---------------------------------------------------------------
# Comma-separated storefront origins permitted to call the chat endpoint.
WIDGET_ALLOWED_ORIGINS=

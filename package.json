{
  "name": "bit-concierge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @bitc/db run generate",
    "db:migrate": "pnpm --filter @bitc/db run migrate",
    "db:rollback": "pnpm --filter @bitc/db run rollback",
    "db:reset": "pnpm --filter @bitc/db run reset",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:clean": "bash scripts/verify-clean.sh",
    "db:seed": "pnpm --filter @bitc/db run seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
